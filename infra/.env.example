DB_NAME=oficina_db
# Superuser: only used by the postgres container to initialise the database
DB_USER=postgres
DB_PASSWORD=
# Least-privilege role used by the backend (avoid the characters ' and " in these values)
APP_DB_USER=oficina_app
APP_DB_PASSWORD=

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 = session cookie only over HTTPS (default). Use 0 only for local development over plain HTTP.
COOKIE_SECURE=1

FRONTEND_PORT=8080
# Names/IPs the certificate must cover (what people type in the browser), e.g.
# DNS:localhost,IP:127.0.0.1,IP:192.168.0.10
TLS_SAN=DNS:localhost,IP:127.0.0.1
GEMINI_API_KEY=
